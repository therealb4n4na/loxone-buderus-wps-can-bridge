# Optional overrides for wps-can-bridge.service.
# Copy the values you need to /etc/default/wps-can-bridge.

WPS_CAN_IF=can0
WPS_CAN_BITRATE=125000
WPS_PORT=8097

# Leave unset to bind to the primary local IPv4 address automatically.
# WPS_BIND_IP=<bridge-lan-ip>

# Optional integration with a local/remote KM200 bridge.
# WPS_KM200_URL=http://<km200-bridge-host>:8095/loxone
# Set an empty value to disable KM200 enrichment:
# WPS_KM200_URL=
WPS_KM200_TIMEOUT_S=1.0

WPS_CHANGE_LOG_DIR=/opt/wps-can-bridge/logs
