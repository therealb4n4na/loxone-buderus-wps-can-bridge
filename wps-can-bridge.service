[Unit]
Description=Buderus WPS Rego1000 CAN Bridge
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/wps-can-bridge/wps_can_bridge.py
Restart=always
RestartSec=5
User=root

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
